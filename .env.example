# Copy to .env and fill in your values

# Email (registration / password reset)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Expo / Metro — IP komputera w LAN (Expo Go: exp://HOSTNAME:8081) lub localhost (tylko web)
HOSTNAME=192.168.1.100

# Backend URL dla aplikacji (opcjonalnie; domyślnie http://HOSTNAME:8080)
# EXPO_PUBLIC_API_BASE=http://192.168.1.100:8080

# EXPO_START_WEB=1  # opcjonalnie: uruchom też serwer web (port 19006)

# PostgreSQL
DB_NAME=selfimprovement
DB_USER=postgres
DB_PASSWORD=your_db_password
